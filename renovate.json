{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  "timezone": "Europe/Rome",
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "description": "Docker / Compose majors need human review",
      "matchManagers": ["docker-compose", "dockerfile"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Group Traefik-related images",
      "matchPackageNames": ["traefik", "traefik/whoami"],
      "groupName": "traefik images"
    },
    {
      "description": "CrowdSec image alone (coupled with Traefik plugin)",
      "matchPackageNames": ["crowdsecurity/crowdsec"],
      "groupName": "crowdsec"
    },
    {
      "description": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "groupName": "github-actions"
    },
    {
      "description": "Do not automerge Traefik plugin majors",
      "matchPackageNames": [
        "maxlerebourg/crowdsec-bouncer-traefik-plugin",
        "jcchavezs/coraza-http-wasm-traefik"
      ],
      "matchUpdateTypes": ["major", "minor"],
      "dependencyDashboardApproval": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Traefik experimental plugins in traefik.yml",
      "fileMatch": ["^traefik/traefik\\.yml$"],
      "matchStrings": [
        "moduleName: github\\.com/(?<depName>[^\\n]+)\\n\\s+version: (?<currentValue>v?[^\\n]+)"
      ],
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Default OWASP CRS pin in Go",
      "fileMatch": ["^backend/internal/protections/update\\.go$"],
      "matchStrings": ["defaultCRS = \"(?<currentValue>v[0-9.]+)\""],
      "depNameTemplate": "coreruleset/coreruleset",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "CRS pin in fetch-crs.sh",
      "fileMatch": ["^scripts/fetch-crs\\.sh$"],
      "matchStrings": ["CRS_VER=\"?(?<currentValue>v[0-9.]+)\"?"],
      "depNameTemplate": "coreruleset/coreruleset",
      "datasourceTemplate": "github-releases"
    }
  ]
}
