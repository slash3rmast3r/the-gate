# The Gate — copy to .env before deploy
DOMAIN=overthecloud.it
ACME_EMAIL=admin@overthecloud.it

# Admin UI
GATE_PORT=9444
GATE_ADMIN_USER=admin
GATE_ADMIN_PASSWORD=CHANGE_ME_STRONG
GATE_SESSION_SECRET=CHANGE_ME_GENERATE_64_HEX

# Admin login: local | oidc | both
GATE_AUTH_MODE=local
# Authentik OIDC provider for The Gate UI (when oidc/both)
# GATE_OIDC_ISSUER=https://auth.example.com/application/o/the-gate/
# GATE_OIDC_CLIENT_ID=
# GATE_OIDC_CLIENT_SECRET=
# GATE_OIDC_REDIRECT_URL=https://gate.example.com:9444/api/auth/oidc/callback

# Forward-auth for applications (Authentik Traefik outpost)
AUTHENTIK_FORWARD_URL=http://authentik-server:9000/outpost.goauthentik.io/auth/traefik

# CrowdSec bouncer key (openssl rand -hex 32)
BOUNCER_KEY_TRAEFIK=CHANGE_ME_GENERATE_64_HEX

# Postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG
POSTGRES_USER=gate
POSTGRES_DB=gate

# Protection feeds (UI buttons + optional cron)
GATE_AUTO_UPDATE_PROTECTIONS=false
GATE_AUTO_UPDATE_HOURS=24

SUBNET_PREFIX=172.23.223
TZ=Europe/Rome
